{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {},
    "Clusters": {}
  },
  "YarpOpenApi": {
    "MergeDocuments": true,
    "ServerUrl": "http://localhost:5000",
    "SecuritySchemes": {
      "Bearer": {
        "Type": "Http",
        "Scheme": "bearer",
        "BearerFormat": "JWT",
        "In": "Header",
        "Name": "Authorization"
      }
    }
  },
  "AllowedHosts": "*"
}
